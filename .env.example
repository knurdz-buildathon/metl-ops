# Metl Production Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ============================================
# Azure / Infrastructure
# ============================================
DATA_SERVER_IP=10.0.1.5          # VM-2 Private IP
VM1_PRIVATE_IP=137.116.33.228    # VM-1 Public IP
VM3_PRIVATE_IP=20.14.150.196     # VM-3 Public IP

# ============================================
# Database
# ============================================
POSTGRES_USER=metl_prod_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_32_CHAR_RANDOM
POSTGRES_DB=metl

# Redis
REDIS_HOST=${DATA_SERVER_IP}
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ============================================
# NATS JetStream
# ============================================
NATS_URL=nats://${DATA_SERVER_IP}:4222

# ============================================
# Let's Encrypt / SSL
# ============================================
LETSENCRYPT_EMAIL=your-email@example.com

# ============================================
# Application Secrets
# ============================================
# Simple Vault
VAULT_KEY=CHANGE_THIS_TO_64_HEX_CHARS_USE_OPENSSL_RAND_HEX_32

# SonarQube Self-Hosted
SONARQUBE_URL=http://${DATA_SERVER_IP}:9000
SONARQUBE_TOKEN=your-sonarqube-token
SONARQUBE_ADMIN_PASSWORD=CHANGE_THIS_SONAR_ADMIN

# ============================================
# Microsoft AI Foundry (Primary AI provider)
# Supports: GPT-4o, GLM-4, KimiK, DeepSeek, Grok
# ============================================
AI_FOUNDRY_ENDPOINT_1=
AI_FOUNDRY_KEY_1=
AI_FOUNDRY_MODEL_1=gpt-4o

AI_FOUNDRY_ENDPOINT_2=
AI_FOUNDRY_KEY_2=
AI_FOUNDRY_MODEL_2=glm-4

AI_FOUNDRY_ENDPOINT_3=
AI_FOUNDRY_KEY_3=
AI_FOUNDRY_MODEL_3=kimi

AI_FOUNDRY_ENDPOINT_4=
AI_FOUNDRY_KEY_4=
AI_FOUNDRY_MODEL_4=deepseek-chat

AI_FOUNDRY_ENDPOINT_5=
AI_FOUNDRY_KEY_5=
AI_FOUNDRY_MODEL_5=grok

# ============================================
# Gemini Fallback
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# OpenAI Last-Resort Fallback
# ============================================
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# Cursor SDK Cloud Agents (Primary vibe-coding)
# ============================================
CURSOR_API_KEY_1=
CURSOR_API_KEY_2=
CURSOR_API_KEY_3=

# ============================================
# Monitoring
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ============================================
# GitHub Container Registry
# ============================================
GITHUB_USER=your-github-username
GHCR_TOKEN=ghp_your-github-personal-access-token

# ============================================
# Backup (Azure Blob Storage)
# ============================================
AZURE_STORAGE_ACCOUNT=metlbackups
AZURE_STORAGE_KEY=your-azure-storage-account-key
AZURE_BACKUP_CONTAINER=metl-backups

# ============================================
# Optional: SMTP for alerts
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=admin@metl.run
